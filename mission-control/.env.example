# ── FuseBase Gate Auth (Trinity ONLY — no Supabase) ──────────────────────────
# Keine Secrets committen. Token nur in Railway / Make Secrets.
# Login UI: /login + TopBar → /api/auth/login | /api/auth/magic-link | /api/auth/password-restore | /api/auth/me
FUSEBASE_GATE_URL=https://app-api.thefusebase.com/v4/api/proxy/gate-service/v1
FUSEBASE_ORG_ID=u27hpp
FUSEBASE_PORTAL_ID=78bzunejje5rp2zfmih2dey9b
FUSEBASE_TOKEN=                           # Bearer Service-Token (serverseitig)
FUSEBASE_APP_HOST=                        # Trinity App-Host für Magic-Link, z.B. mission-control-production-09f8.up.railway.app
PROVISION_WEBHOOK_SECRET=                 # Shared secret Make → POST /api/provision/foerder
# Public Shopify Fördermitgliedschaft (3,33 €) — override optional; default in lib/membership.ts
NEXT_PUBLIC_FOERDER_PRODUCT_URL=https://youareneo.com/products/you-are-neo-community-access
# APP_SECRET already above — required for mc_session HMAC cookie (>=16 chars)

# Hostinger staging host (hostname only):
# FUSEBASE_APP_HOST=mission-control-stg.srv1966331.hstgr.cloud

# Optional scoped agent access (off until configured on a secured host)
TRINITY_MCP_ENABLED=false
TRINITY_PUBLIC_URL=https://trinity.youareneo.com
# Persistent, private volume; requires Node >=22.13. Single-process deployment.
TRINITY_MCP_DB=data/private-mcp.sqlite

# Optional single-owner HubSpot contacts read connection; no public browser tokens
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_TRINITY_USER_ID=

# Dedicated org-scoped FuseBase token with ONLY email.write for VPS login emails.
# Existing FUSEBASE_TOKEN continues to resolve organization members.
FUSEBASE_AUTH_MAIL_TOKEN=
# Magic links: 20 minutes, single use, hashed tokens in DATA_DIR/private-auth.sqlite.
