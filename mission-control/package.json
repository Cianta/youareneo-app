{
  "name": "mission-control",
  "version": "1.0.0",
  "description": "guiding.space – persönliches Guiding System",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "node server.js",
    "lint": "next lint",
    "setup": "node scripts/setup.mjs",
    "electron:build": "node scripts/electron-build.js",
    "test:auth": "tsx --test tests/auth.test.ts",
    "test:assistant": "tsx --test tests/assistant.test.ts",
    "test:assistant:browser": "node scripts/test-assistant-browser.mjs",
    "test:voice": "tsx --test tests/voice.test.ts",
    "test:workspace": "tsx --test tests/workspace.test.ts",
    "test:workspace:browser": "node scripts/test-workspace-browser.mjs",
    "test:notes:browser": "node scripts/test-notes-browser.mjs",
    "audit:workspace:local": "node scripts/audit-workspace-local.mjs",
    "test:brain": "tsx --test tests/brain.test.ts",
    "test:brain:browser": "node scripts/test-brain-browser.mjs",
    "test:chat": "tsx --test tests/chat.test.ts",
    "test:chat:browser": "node scripts/test-chat-browser.mjs",
    "test:apps": "tsx --test tests/apps.test.ts",
    "test:apps:browser": "node scripts/test-apps-browser.mjs",
    "audit:apps:local": "node scripts/audit-apps-local.mjs",
    "test:restored": "tsx --test tests/restored.test.ts",
    "test:restored:browser": "node scripts/test-restored-browser.mjs"
  },
  "build": {
    "appId": "com.youareneo.mission-control",
    "productName": "guiding.space",
    "asar": false,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build-resources/icon.icns"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone-clean",
        "to": "nextjs",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fusebase/fusebase-gate-sdk": "2.11.8-sdk.0",
    "@google/generative-ai": "^0.14.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "astronomy-engine": "2.1.19",
    "city-timezones": "1.3.4",
    "clsx": "^2.1.1",
    "fflate": "0.8.3",
    "framer-motion": "^11.3.0",
    "free-human-design": "1.0.1",
    "jspdf": "4.2.1",
    "lucide-react": "^0.400.0",
    "next": "^16.2.7",
    "openai": "^4.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "1.29.2",
    "react-force-graph-3d": "1.29.2",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.4.0",
    "three": "0.186.1",
    "uuid": "^10.0.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "0.186.0",
    "@types/uuid": "^10",
    "autoprefixer": "^10.4.19",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "lighthouse": "13.5.0",
    "postcss": "^8.4.40",
    "puppeteer-core": "25.12.0",
    "tailwindcss": "^3.4.6",
    "tsx": "4.20.6",
    "typescript": "^5.5.3"
  }
}
