{
  "name": "mission-control",
  "version": "1.0.0",
  "description": "AI Agent Operating System — Academy Mission Control Dashboard",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "node server.js",
    "lint": "next lint",
    "setup": "node scripts/setup.mjs",
    "electron:build": "node scripts/electron-build.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.youareneo.mission-control",
    "productName": "Mission Control",
    "asar": false,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build-resources/icon.icns"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone-clean",
        "to": "nextjs",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.26.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fusebase/fusebase-gate-sdk": "2.11.8-sdk.0",
    "@google/generative-ai": "^0.14.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "astronomy-engine": "2.1.19",
    "city-timezones": "1.3.4",
    "clsx": "^2.1.1",
    "fflate": "0.8.2",
    "framer-motion": "^11.3.0",
    "free-human-design": "1.0.1",
    "lucide-react": "^0.400.0",
    "next": "^16.2.7",
    "openai": "^4.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.4.0",
    "uuid": "^10.0.0",
    "zod": "3.25.76",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10",
    "autoprefixer": "^10.4.19",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3"
  }
}
