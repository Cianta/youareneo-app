<div
  class="slideshow__slide grid__item grid--1-col"
  id="Slide-{{ section.id }}"
  {{ block.shopify_attributes }}
  role="group"
  aria-roledescription="{{ 'sections.announcements.announcement' | t }}"
  aria-label="{{ 'general.slider.of' | t }}"
  tabindex="-1"
>
  <div
    class="announcement-bar__announcement"
    role="region"
    aria-label="{{ 'sections.header.announcement' | t }}"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.text != blank -%}
      {%- if block.settings.link != blank -%}
        <a
          href="{{ block.settings.link }}"
          class="announcement-bar__link link link--text focus-inset animate-arrow"
        >
      {%- endif -%}
      <p class="announcement-bar__message {{ block.settings.text_size }}">
        {%- comment -%} „YOU ARE NEO - Design Your Life Art“: der Teil nach dem Bindestrich leuchtet in Bronze {%- endcomment -%}
        {%- assign ab_parts = block.settings.text | split: ' - ' -%}
        {%- if ab_parts.size > 1 -%}
          <span>{{ ab_parts.first | escape }} <span class="es-ab-dash">–</span> <span class="es-ab-bronze">{{ ab_parts | slice: 1, 9 | join: ' - ' | escape }}</span></span>
        {%- else -%}
          <span>{{ block.settings.text | escape }}</span>
        {%- endif -%}
        {%- if block.settings.link != blank -%}
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        {%- endif -%}
      </p>
      {%- if block.settings.link != blank -%}
        </a>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
<style>
  .announcement-bar__message .es-ab-dash { opacity: .55; }
  .announcement-bar__message .es-ab-bronze {
    font-style: italic; letter-spacing: .06em;
    background: linear-gradient(100deg, #8a5a2b 0%, #cd8f52 35%, #f0c08a 52%, #b8753c 70%, #7a4a20 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    text-shadow: none;
  }
</style>

{% schema %}
{
  "name": "t:blocks.minimum_order.settings.dbtfy_minimum_order_message.label",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
      "label": "t:general.settings.text",
      "info": "Text nach „ - “ erscheint in Bronze"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.all.button.option_1_label"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "t:general.settings.size.label",
      "options": [
        {
          "value": "h5",
          "label": "t:general.settings.small"
        },
        {
          "value": "h3",
          "label": "t:sections.all.animation.image_behavior.parallax_speed.medium"
        },
        {
          "value": "h2",
          "label": "t:sections.image_banner.settings.section_height_mobile.options__4.label"
        }
      ],
      "default": "h5"
    }
  ],
  "presets": [{ "name": "t:blocks.minimum_order.settings.dbtfy_minimum_order_message.label" }]
}
{% endschema %}
