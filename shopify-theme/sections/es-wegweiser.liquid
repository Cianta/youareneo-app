{%- comment -%}
  Wegweiser: 12 Knöpfe in zwei Reihen à sechs, ganz oben auf der Übersichtsseite.
  Jeder Knopf hat ein eigenes Symbol und eine eigene, gedämpfte Farbe (alle aus derselben Erd-/Edelstein-Palette).
  Knöpfe sind Blöcke – Text, Link, Symbol und Farbe lassen sich im Theme-Editor ändern.
{%- endcomment -%}
<section id="WW-{{ section.id }}" class="ww">
  {%- if section.settings.title != blank -%}<p class="ww__kicker">{{ section.settings.title | escape }}</p>{%- endif -%}
  <nav class="ww__grid" aria-label="{{ section.settings.title | default: 'Wegweiser' | escape }}">
    {%- for block in section.blocks -%}
      <a class="ww__btn" href="{{ block.settings.link | default: '#' }}" style="--ww-c: {{ block.settings.color }};" {{ block.shopify_attributes }}>
        <span class="ww__ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            {%- case block.settings.icon -%}
              {%- when 'community' -%}<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9.5" r="2.4"/><path d="M3.5 19c.6-3.2 3-5 5.5-5s4.9 1.8 5.5 5"/><path d="M14.8 14.6c2.4-.5 4.9.9 5.7 4.4"/>
              {%- when 'vision' -%}<path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="3"/><path d="M12 2v1.5M4.9 4.9l1 1M19.1 4.9l-1 1"/>
              {%- when 'projekt' -%}<path d="M12 21V11"/><path d="M12 11c0-4 3-6.5 7-6.5 0 4-3 6.5-7 6.5z"/><path d="M12 14c0-3-2.3-5-5.5-5 0 3 2.3 5 5.5 5z"/><path d="M7 21h10"/>
              {%- when 'event' -%}<rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/><path d="M12 13.2l.9 1.8 2 .3-1.45 1.4.35 2-1.8-.95-1.8.95.35-2L9.1 15.3l2-.3z"/>
              {%- when 'leben' -%}<path d="M12 3c-3.3 3-3.3 6.5 0 9 3.3-2.5 3.3-6 0-9z"/><path d="M12 12c-4.2-1.4-7.5.2-8.5 3.8 3.4 1.2 6.8.1 8.5-3.8zM12 12c4.2-1.4 7.5.2 8.5 3.8-3.4 1.2-6.8.1-8.5-3.8z"/><path d="M12 12v9"/>
              {%- when 'news' -%}<path d="M5 4.5h11.5V19a1.5 1.5 0 0 0 1.5 1.5H6A2 2 0 0 1 4 18.5V5.5"/><path d="M16.5 8.5H20v10a2 2 0 0 1-2 2"/><path d="M7.5 8h6M7.5 11.5h6M7.5 15h4"/>
              {%- when 'blog' -%}<path d="M15.5 4.5l4 4L9 19l-5 1 1-5z"/><path d="M13.5 6.5l4 4"/><path d="M4 21h16" opacity=".5"/>
              {%- when 'tools' -%}<path d="M14.7 6.3a4 4 0 0 0-5.4 5.1L3.8 17a1.9 1.9 0 0 0 2.7 2.7l5.6-5.5a4 4 0 0 0 5.1-5.4l-2.4 2.4-2.3-.4-.4-2.3z"/>
              {%- when 'archiv' -%}<rect x="3" y="4" width="18" height="4.5" rx="1.2"/><path d="M5 8.5V19a1.5 1.5 0 0 0 1.5 1.5h11A1.5 1.5 0 0 0 19 19V8.5"/><path d="M10 12.5h4"/>
              {%- when 'kontakt' -%}<rect x="3" y="5.5" width="18" height="13" rx="2.5"/><path d="M3.8 7l8.2 6.2L20.2 7"/>
              {%- when 'kunde' -%}<circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20.5c.9-3.9 3.9-6 7.5-6s6.6 2.1 7.5 6"/>
              {%- when 'mitglied' -%}<path d="M12 3l7.5 3v5.4c0 4.6-3.2 8.2-7.5 9.6-4.3-1.4-7.5-5-7.5-9.6V6z"/><path d="M12 8.3l1.2 2.4 2.6.4-1.9 1.8.45 2.6L12 14.3l-2.35 1.2.45-2.6-1.9-1.8 2.6-.4z"/>
              {%- else -%}<circle cx="12" cy="12" r="8"/><path d="M12 8v8M8 12h8"/>
            {%- endcase -%}
          </svg>
        </span>
        <span class="ww__label">{{ block.settings.label | escape }}</span>
      </a>
    {%- endfor -%}
  </nav>
</section>

<style>
  #WW-{{ section.id }} {
    position: relative; z-index: 3; padding: clamp(28px, 5vw, 56px) 16px clamp(24px, 4vw, 44px);
    background: radial-gradient(ellipse at 50% 0%, #1b2140 0%, #0b0d16 75%);
    color: #f1ead8;
  }
  #WW-{{ section.id }} .ww__kicker { margin: 0 0 22px; text-align: center; font-size: .78rem; letter-spacing: .4em; text-transform: uppercase; color: #ddb771; }
  #WW-{{ section.id }} .ww__grid {
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: clamp(10px, 1.4vw, 18px);
    max-width: 1180px; margin: 0 auto;
  }
  #WW-{{ section.id }} .ww__btn {
    position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
    min-height: 116px; padding: 18px 10px 16px; border-radius: 18px; text-decoration: none; color: #f6efdf;
    background: linear-gradient(160deg, color-mix(in srgb, var(--ww-c) 22%, #12152a) 0%, color-mix(in srgb, var(--ww-c) 8%, #0d0f1c) 100%);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ww-c) 45%, transparent), 0 8px 22px rgba(0,0,0,.28);
    transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s, background .35s;
    overflow: hidden; isolation: isolate;
  }
  /* sanfter Lichtschimmer, der beim Darüberfahren über den Knopf läuft */
  #WW-{{ section.id }} .ww__btn::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(115deg, transparent 30%, color-mix(in srgb, var(--ww-c) 35%, transparent) 50%, transparent 70%);
    transform: translateX(-120%); transition: transform .8s ease;
  }
  #WW-{{ section.id }} .ww__btn:hover, #WW-{{ section.id }} .ww__btn:focus-visible {
    transform: translateY(-4px);
    box-shadow: inset 0 0 0 1px var(--ww-c), 0 14px 32px color-mix(in srgb, var(--ww-c) 30%, rgba(0,0,0,.35));
  }
  #WW-{{ section.id }} .ww__btn:hover::after, #WW-{{ section.id }} .ww__btn:focus-visible::after { transform: translateX(120%); }
  #WW-{{ section.id }} .ww__ico {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    color: color-mix(in srgb, var(--ww-c) 70%, #fff);
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ww-c) 28%, transparent), transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ww-c) 40%, transparent);
  }
  #WW-{{ section.id }} .ww__ico svg { width: 26px; height: 26px; }
  #WW-{{ section.id }} .ww__label { font-size: .92rem; font-weight: 600; letter-spacing: .06em; text-align: center; line-height: 1.2; }
  @media (max-width: 989px) { #WW-{{ section.id }} .ww__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 599px) {
    #WW-{{ section.id }} .ww__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    #WW-{{ section.id }} .ww__btn { min-height: 92px; padding: 12px 6px; border-radius: 14px; gap: 7px; }
    #WW-{{ section.id }} .ww__ico { width: 38px; height: 38px; } #WW-{{ section.id }} .ww__ico svg { width: 21px; height: 21px; }
    #WW-{{ section.id }} .ww__label { font-size: .78rem; letter-spacing: .03em; }
  }
  @media (prefers-reduced-motion: reduce) { #WW-{{ section.id }} .ww__btn, #WW-{{ section.id }} .ww__btn::after { transition: none; } }
</style>

{% schema %}
{
  "name": "Wegweiser (12 Knöpfe)",
  "tag": "div",
  "class": "section-es-wegweiser",
  "max_blocks": 18,
  "settings": [
    { "type": "text", "id": "title", "label": "Kleine Überschrift", "default": "Wohin möchtest du?" }
  ],
  "blocks": [
    {
      "type": "knopf",
      "name": "Knopf",
      "settings": [
        { "type": "text", "id": "label", "label": "Text", "default": "Community" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "icon", "label": "Symbol", "default": "community", "options": [
          { "value": "community", "label": "Menschen" }, { "value": "vision", "label": "Auge / Vision" },
          { "value": "projekt", "label": "Spross / Projekt" }, { "value": "event", "label": "Kalender" },
          { "value": "leben", "label": "Lotus / Lebenskunst" }, { "value": "news", "label": "Zeitung" },
          { "value": "blog", "label": "Feder / Stift" }, { "value": "tools", "label": "Werkzeug" },
          { "value": "archiv", "label": "Archivbox" }, { "value": "kontakt", "label": "Brief" },
          { "value": "kunde", "label": "Person" }, { "value": "mitglied", "label": "Schild mit Stern" }
        ] },
        { "type": "color", "id": "color", "label": "Farbe", "default": "#5f9e8f" }
      ]
    }
  ],
  "presets": [{
    "name": "Wegweiser (12 Knöpfe)",
    "blocks": [
      { "type": "knopf", "settings": { "label": "Community", "icon": "community", "color": "#5f9e8f", "link": "/pages/community" } },
      { "type": "knopf", "settings": { "label": "Visionen", "icon": "vision", "color": "#7b6fb0", "link": "/pages/visions" } },
      { "type": "knopf", "settings": { "label": "Projekte", "icon": "projekt", "color": "#6f9a52", "link": "/pages/projekte" } },
      { "type": "knopf", "settings": { "label": "Events", "icon": "event", "color": "#c27a4a", "link": "/pages/events" } },
      { "type": "knopf", "settings": { "label": "Lebenskünste", "icon": "leben", "color": "#b5739b", "link": "/pages/lebenskunste" } },
      { "type": "knopf", "settings": { "label": "News", "icon": "news", "color": "#b08d57", "link": "/pages/news" } },
      { "type": "knopf", "settings": { "label": "Blog", "icon": "blog", "color": "#4f8fb0", "link": "/pages/blog" } },
      { "type": "knopf", "settings": { "label": "Tools", "icon": "tools", "color": "#8a94a6", "link": "/pages/one-solution" } },
      { "type": "knopf", "settings": { "label": "Archiv", "icon": "archiv", "color": "#9a7b5c", "link": "/pages/archiv" } },
      { "type": "knopf", "settings": { "label": "Kontakt", "icon": "kontakt", "color": "#3f9aa0", "link": "/pages/kontakt" } },
      { "type": "knopf", "settings": { "label": "Kundenportal", "icon": "kunde", "color": "#a06a6a", "link": "/account" } },
      { "type": "knopf", "settings": { "label": "Mitgliederbereich", "icon": "mitglied", "color": "#c9a24a", "link": "/pages/mitgliederbereiche" } }
    ]
  }]
}
{% endschema %}
