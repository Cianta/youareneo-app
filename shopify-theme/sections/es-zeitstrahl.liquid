{%- comment -%}
  Zeitstrahl in 3D: die Entstehungsgeschichte von YOU ARE NEO.
  Header-Logo → Erde (rechts oben, eine Ebene vor dem Header, dreht sich zum Land der Station),
  Fotos setzen sich von allen Seiten zusammen, dahinter die Landkarte (Umriss, Gebirge, Wälder, Städte),
  der Weg durch den Raum mit einem Tor pro Station, links der große Baum des Lebens – pro Station ein goldenes Blatt.
  Stationen: Daten aus dem Freigeist Archiv (Vereinsgeschichte, Sammlungen) – bitte noch abgleichen.
{%- endcomment -%}
{%- if images['elemente-logo.webp'] -%}{%- assign zs_logo = images['elemente-logo.webp'] | image_url: width: 400 -%}{%- else -%}{%- assign zs_logo = 'elemente-logo.webp' | asset_url -%}{%- endif -%}
<section id="ZS-{{ section.id }}" class="zs" data-sid="{{ section.id }}" data-logo="{{ zs_logo }}">
  <div class="zs__stage">
    <canvas class="zs__map" aria-hidden="true"></canvas>
    <canvas class="zs__path" aria-hidden="true"></canvas>
    <canvas class="zs__tree" aria-hidden="true"></canvas>
    <div class="zs__cards" aria-hidden="true"></div>
    <div class="zs__intro">
      <p class="zs__kicker">YOU ARE NEO</p>
      <h1 class="zs__h1">{{ section.settings.title }}</h1>
      <p class="zs__sub">{{ section.settings.subtitle }}</p>
      <p class="zs__hint">scrollen ↓</p>
    </div>
    <div class="zs__text" aria-live="polite"><div class="zs__year"></div><h2 class="zs__title"></h2><p class="zs__body"></p><p class="zs__place"></p></div>
    <svg class="zs__line" aria-hidden="true"></svg>
    <div class="zs__globe" id="ZSG-{{ section.id }}"><canvas aria-hidden="true"></canvas><img alt="" class="zs__logo"></div>
    <a class="zs__cta" href="{{ section.settings.cta_link | default: routes.account_register_url }}">{{ section.settings.cta }}</a>
  </div>
</section>

