<style>
  #ZS-{{ section.id }} { position: relative; height: calc(var(--zs-n, 9) * 120vh); background: radial-gradient(ellipse at 50% 30%, #1b2140 0%, #0b0d16 60%, #07080d 100%); color: #f1ead8; }
  #ZS-{{ section.id }} .zs__stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; perspective: 1400px; }
  #ZS-{{ section.id }} .zs__map { position: absolute; inset: -10% -5% 0; width: 110%; height: 110%; transform: rotateX(42deg) translateY(-6%); transform-origin: 50% 70%; opacity: .9; pointer-events: none; }
  #ZS-{{ section.id }} .zs__path { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }
  #ZS-{{ section.id }} .zs__tree { position: absolute; left: 0; bottom: 0; width: min(46vw, 620px); height: 96%; pointer-events: none; z-index: 2; }
  #ZS-{{ section.id }} .zs__cards { position: absolute; inset: 0; transform-style: preserve-3d; pointer-events: none; z-index: 3; }
  #ZS-{{ section.id }} .zs__card { position: absolute; left: 50%; top: 42%; width: min(46vw, 460px); aspect-ratio: 3 / 2; margin: calc(min(46vw, 460px) / -2 * .6667) 0 0 calc(min(46vw, 460px) / -2);
    transform-style: preserve-3d; visibility: hidden; will-change: transform, opacity; }
  #ZS-{{ section.id }} .zs__tile { position: absolute; overflow: hidden; background: #111; backface-visibility: hidden; will-change: transform, opacity;
    box-shadow: 0 18px 40px rgba(0,0,0,.35); outline: 1px solid rgba(221,183,113,.18); }
  #ZS-{{ section.id }} .zs__tile:nth-child(1) { border-top-left-radius: 16px; } #ZS-{{ section.id }} .zs__tile:nth-child(3) { border-top-right-radius: 16px; }
  #ZS-{{ section.id }} .zs__tile:nth-child(7) { border-bottom-left-radius: 16px; } #ZS-{{ section.id }} .zs__tile:nth-child(9) { border-bottom-right-radius: 16px; }
  #ZS-{{ section.id }} .zs__tile img { position: absolute; object-fit: cover; display: block; max-width: none; }
  #ZS-{{ section.id }} .zs__intro { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; z-index: 4; pointer-events: none; padding: 0 20px; }
  #ZS-{{ section.id }} .zs__kicker { letter-spacing: .4em; font-size: .78rem; color: #ddb771; margin: 0 0 10px; }
  #ZS-{{ section.id }} .zs__h1 { font-size: clamp(2rem, 6vw, 4.2rem); margin: 0; font-weight: 300; letter-spacing: .04em; color: #fff7e6; }
  #ZS-{{ section.id }} .zs__sub { margin: 14px 0 0; opacity: .8; font-size: clamp(.95rem, 2vw, 1.15rem); }
  #ZS-{{ section.id }} .zs__hint { margin-top: 36px; font-size: .75rem; letter-spacing: .3em; opacity: .55; animation: zs-bob 2.4s ease-in-out infinite; }
  @keyframes zs-bob { 50% { transform: translateY(6px); } }
  #ZS-{{ section.id }} .zs__text { position: absolute; right: 5vw; bottom: 14vh; z-index: 5; width: min(440px, 40vw); opacity: 0; text-shadow: 0 2px 14px rgba(0,0,0,.7); }
  #ZS-{{ section.id }} .zs__year { font-size: clamp(2rem, 6vw, 3.6rem); font-weight: 200; color: #ddb771; line-height: 1; }
  #ZS-{{ section.id }} .zs__title { margin: 6px 0 8px; font-size: clamp(1.1rem, 2.6vw, 1.7rem); font-weight: 500; color: #fff7e6; }
  #ZS-{{ section.id }} .zs__body { margin: 0; line-height: 1.6; opacity: .9; font-size: clamp(.9rem, 1.6vw, 1.02rem); }
  #ZS-{{ section.id }} .zs__place { margin: 8px 0 0; font-size: .72rem; letter-spacing: .25em; text-transform: uppercase; color: #9fd3cf; }
  #ZS-{{ section.id }} .zs__line { position: absolute; left: 0; bottom: 0; width: 100%; height: 8vh; z-index: 4; overflow: visible; opacity: .75; }
  /* Erde: wird per Skript an <body> gehängt → liegt als eigene Ebene vor dem Header */
  #ZSG-{{ section.id }} { position: fixed; left: 0; top: 0; width: 140px; height: 140px; z-index: 2147483000; pointer-events: none; transform-origin: 50% 50%; will-change: transform; visibility: hidden;
    filter: drop-shadow(0 10px 22px rgba(0,0,0,.45)); }
  #ZSG-{{ section.id }} canvas, #ZSG-{{ section.id }} .zs__logo { position: absolute; inset: 0; width: 100%; height: 100%; }
  #ZSG-{{ section.id }} .zs__logo { object-fit: contain; filter: drop-shadow(0 0 18px rgba(221,183,113,.45)); }
  #ZS-{{ section.id }} .zs__cta { position: absolute; left: 50%; bottom: 20vh; transform: translateX(-50%); z-index: 7; opacity: 0; pointer-events: none;
    padding: 16px 34px; border-radius: 999px; text-decoration: none; color: #262b38; font-weight: 600; letter-spacing: .08em;
    background: linear-gradient(115deg, #f4dfb0, #c79a3c 45%, #fff3cf 60%, #b8862f); box-shadow: 0 12px 34px rgba(221,183,113,.4); }
  @media (max-width: 749px) {
    #ZS-{{ section.id }} .zs__card { width: 78vw; margin: calc(78vw / -2 * .6667) 0 0 -39vw; top: 36%; }
    #ZS-{{ section.id }} .zs__text { left: 6vw; right: 6vw; width: auto; bottom: 11vh; }
    #ZS-{{ section.id }} .zs__tree { width: 80vw; opacity: .5; }
  }
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/topojson-client@3/dist/topojson-client.min.js" defer></script>
<script src="{{ 'elemente-zeitstrahl.js' | file_url }}" defer></script>

{% schema %}
{
  "name": "Zeitstrahl 3D",
  "settings": [
    { "type": "text", "id": "title", "label": "Titel", "default": "Entstehungsgeschichte" },
    { "type": "text", "id": "subtitle", "label": "Untertitel", "default": "Ein Verein, der die Welt ins goldene Zeitalter begleitet" },
    { "type": "text", "id": "cta", "label": "Knopf am Ende", "default": "Werde Teil der Geschichte" },
    { "type": "url", "id": "cta_link", "label": "Link" }
  ],
  "presets": [{ "name": "Zeitstrahl 3D" }]
}
{% endschema %}
